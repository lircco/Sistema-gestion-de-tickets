# Copiá este archivo a `.env` (en la raíz, junto a docker-compose.yml) y ajustá los valores.
# Docker Compose lo lee automáticamente para interpolar las variables ${...}.

DB_NAME=app2_db
DB_USER=app2_user
DB_PASSWORD=app2_password
DB_PORT=5432

# Generá una clave propia para producción
DJANGO_SECRET_KEY=django-insecure-dev-only-change-me
