# Copiá este archivo como `.env` (raíz del repo) y completá los valores.
# Docker Compose lo usa para interpolar docker-compose.yml y Django lo carga al iniciar.
# Nunca commitees el `.env` real.

# --- Django ---
# Generá una clave con:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=
# True solo en desarrollo local. Sin DEBUG, DJANGO_SECRET_KEY es obligatoria.
DJANGO_DEBUG=False

# --- Base de datos (PostgreSQL) ---
DB_NAME=app2_db
DB_USER=app2_user
DB_PASSWORD=
DB_PORT=5432
# Alternativa: una URL completa (por ejemplo para usar SQLite en desarrollo/tests)
# DATABASE_URL=sqlite:///db.sqlite3

# --- Email (SMTP de Gmail con contraseña de aplicación) ---
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# --- Registro y autenticación ---
# Código que habilita el auto-registro como Staff. Vacío = deshabilitado (ver #101).
STAFF_REGISTRATION_CODE=
# Validez en segundos del código de recuperación de contraseña (ver #102).
# PASSWORD_RESET_TIMEOUT=1800
